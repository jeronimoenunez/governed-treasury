{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(cat .env)",
      "Bash(npm audit fix --force:*)",
      "Bash(npx hardhat run scripts/deploy.js --network sepolia:*)",
      "Bash(npx hardhat run scripts/interact.js --network sepolia:*)",
      "Edit(./contracts/**)",
      "Write(./contracts/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ]
  }
}
